blueprint:
  name: ROBB ROB_200-007-0 (Z2M Event Version)
  description: Works with Zigbee2MQTT 2.x / 5.x using event entities
  domain: automation

  input:
    remote:
      name: Remote (event entity)
      selector:
        entity:
          domain: event

    on_button_1_short:
      default: []
      selector: { action: {} }
    off_button_1_short:
      default: []
      selector: { action: {} }
    on_button_1_hold:
      default: []
      selector: { action: {} }
    off_button_1_hold:
      default: []
      selector: { action: {} }
    button_1_release:
      default: []
      selector: { action: {} }

    on_button_2_short:
      default: []
      selector: { action: {} }
    off_button_2_short:
      default: []
      selector: { action: {} }
    on_button_2_hold:
      default: []
      selector: { action: {} }
    off_button_2_hold:
      default: []
      selector: { action: {} }
    button_2_release:
      default: []
      selector: { action: {} }

    on_button_3_short:
      default: []
      selector: { action: {} }
    off_button_3_short:
      default: []
      selector: { action: {} }
    on_button_3_hold:
      default: []
      selector: { action: {} }
    off_button_3_hold:
      default: []
      selector: { action: {} }
    button_3_release:
      default: []
      selector: { action: {} }

    on_button_4_short:
      default: []
      selector: { action: {} }
    off_button_4_short:
      default: []
      selector: { action: {} }
    on_button_4_hold:
      default: []
      selector: { action: {} }
    off_button_4_hold:
      default: []
      selector: { action: {} }
    button_4_release:
      default: []
      selector: { action: {} }

mode: restart
max_exceeded: silent

trigger:
  - platform: event
    event_type: state_changed

condition:
  - condition: template
    value_template: >
      {{ trigger.event.data.entity_id == ( !input remote ) }}

action:
  - variables:
      command: "{{ trigger.event.data.new_state.attributes.event_type }}"

  - choose:
      - conditions: "{{ command == 'on_1' }}"
        sequence: !input on_button_1_short
      - conditions: "{{ command == 'off_1' }}"
        sequence: !input off_button_1_short
      - conditions: "{{ command == 'brightness_move_up_1' }}"
        sequence: !input on_button_1_hold
      - conditions: "{{ command == 'brightness_move_down_1' }}"
        sequence: !input off_button_1_hold
      - conditions: "{{ command == 'brightness_stop_1' }}"
        sequence: !input button_1_release

      - conditions: "{{ command == 'on_2' }}"
        sequence: !input on_button_2_short
      - conditions: "{{ command == 'off_2' }}"
        sequence: !input off_button_2_short
      - conditions: "{{ command == 'brightness_move_up_2' }}"
        sequence: !input on_button_2_hold
      - conditions: "{{ command == 'brightness_move_down_2' }}"
        sequence: !input off_button_2_hold
      - conditions: "{{ command == 'brightness_stop_2' }}"
        sequence: !input button_2_release

      - conditions: "{{ command == 'on_3' }}"
        sequence: !input on_button_3_short
      - conditions: "{{ command == 'off_3' }}"
        sequence: !input off_button_3_short
      - conditions: "{{ command == 'brightness_move_up_3' }}"
        sequence: !input on_button_3_hold
      - conditions: "{{ command == 'brightness_move_down_3' }}"
        sequence: !input off_button_3_hold
      - conditions: "{{ command == 'brightness_stop_3' }}"
        sequence: !input button_3_release

      - conditions: "{{ command == 'on_4' }}"
        sequence: !input on_button_4_short
      - conditions: "{{ command == 'off_4' }}"
        sequence: !input off_button_4_short
      - conditions: "{{ command == 'brightness_move_up_4' }}"
        sequence: !input on_button_4_hold
      - conditions: "{{ command == 'brightness_move_down_4' }}"
        sequence: !input off_button_4_hold
      - conditions: "{{ command == 'brightness_stop_4' }}"
        sequence: !input button_4_release
